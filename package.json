    "format:check": "prettier --check \"src/**/*.ts\"",
    "seed": "npx tsx src/seed.ts",
    "create-admin": "npx tsx scripts/create-admin.ts",
    "clear-db": "npx tsx scripts/clear-db.ts",
    "dev": "npx tsx watch src/index.ts"
  },
